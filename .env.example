# Copy to .env and fill in. Never commit real values.
# PostgreSQL connection for the app.
DATABASE_URL="postgresql://printforge:CHANGE_ME@localhost:5432/printforge_dev"
# Separate database used by integration tests (it is wiped before each test file!).
TEST_DATABASE_URL="postgresql://printforge:CHANGE_ME@localhost:5432/printforge_test"
# Where uploaded files are stored (outside the web root).
UPLOAD_DIR="./storage/uploads"
# development | production. Production enables Secure cookies and HSTS.
APP_ENV="development"
# Optional: required to open the first-run setup page when set (recommended on any reachable server).
SETUP_TOKEN=""
