# Production secrets for docker compose (copy to .env.production, never commit it).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Required to open the first-run /setup page. Remove or rotate after creating the owner.
SETUP_TOKEN=change-me-too
# production = Secure cookies + HSTS (requires HTTPS in front of the app).
# Use "development" only for a quick local trial over plain http://localhost.
APP_ENV=production
APP_PORT=3000
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
# Host directory for backup files (copy these off the machine regularly).
BACKUP_HOST_DIR=./backups
