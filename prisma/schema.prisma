// PrintForge data model.
// Conventions:
//  - Money: Decimal(12,2) in ILS (agorot precision). Rates/unit costs: Decimal(12,4).
//  - Percentages are stored as fractions (0.18 = 18%).
//  - Grams: Decimal(10,2). Durations: minutes Decimal(10,2) or hours Decimal(8,2).
//  - Pricing inputs and results are snapshotted as JSON on quotes/orders so later
//    configuration changes never alter an existing document.
// See ARCHITECTURE.md for business invariants.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & security ─────────────────────────────

enum UserRole {
  OWNER
  STAFF
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              UserRole  @default(OWNER)
  isActive          Boolean   @default(true)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]
  payments  Payment[]
}

model Session {
  /// SHA-256 hex digest of the session token. The raw token only lives in the cookie.
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  /// "ip:<addr>" or "email:<normalized>"
  key       String
  succeeded Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     String
  summary    String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

// ───────────────────────────── Settings & numbering ─────────────────────────────

enum VatMode {
  /// VAT-registered dealer (Osek Murshe / company): VAT is added on top of net prices.
  EXCLUSIVE
  /// Exempt dealer (Osek Patur) or VAT not charged: no VAT line.
  EXEMPT
}

enum PricingMethod {
  /// price = cost × (1 + markup)
  MARKUP
  /// price = cost ÷ (1 − margin)
  MARGIN
}

enum RoundingMode {
  UP
  NEAREST
}

/// Singleton row (id = 1).
model Settings {
  id Int @id @default(1)

  // Business profile (appears on customer documents)
  businessName  String  @default("My 3D Print Studio")
  legalName     String?
  businessTaxId String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  postalCode    String?
  country       String  @default("Israel")
  phone         String?
  email         String?
  website       String?
  logoFileId    String?
  brandColor    String  @default("#4f46e5")

  // Locale
  currency String @default("ILS")
  locale   String @default("en-IL")
  timezone String @default("Asia/Jerusalem")

  // Tax
  vatMode VatMode @default(EXCLUSIVE)
  vatRate Decimal @default(0.18) @db.Decimal(6, 4)

  // Cost rates (internal)
  electricityTariffPerKwh   Decimal @default(0.64) @db.Decimal(10, 4)
  laborCostPerHour          Decimal @default(60) @db.Decimal(10, 2)
  scannerCostPerHour        Decimal @default(10) @db.Decimal(10, 2)
  defaultMachineCostPerHour Decimal @default(4) @db.Decimal(10, 4)
  defaultSetupMinutes       Decimal @default(10) @db.Decimal(10, 2)
  materialWastePercent      Decimal @default(0.05) @db.Decimal(6, 4)
  failureAllowancePercent   Decimal @default(0.08) @db.Decimal(6, 4)
  contingencyPercent        Decimal @default(0.03) @db.Decimal(6, 4)
  packingCostPerOrder       Decimal @default(5) @db.Decimal(10, 2)
  transactionFeePercent     Decimal @default(0) @db.Decimal(6, 4)
  transactionFeeFixed       Decimal @default(0) @db.Decimal(10, 2)

  // Billing rates (customer-facing hourly rates for services)
  modelingRatePerHour           Decimal @default(180) @db.Decimal(10, 2)
  scanningRatePerHour           Decimal @default(200) @db.Decimal(10, 2)
  scanCleanupRatePerHour        Decimal @default(150) @db.Decimal(10, 2)
  reverseEngineeringRatePerHour Decimal @default(220) @db.Decimal(10, 2)

  // Commercial defaults
  quoteValidityDays       Int     @default(14)
  defaultDepositPercent   Decimal @default(0) @db.Decimal(6, 4)
  requireDepositToProduce Boolean @default(true)
  defaultPaymentTerms     String? @default("Payment due on delivery.")
  quoteTerms              String?
  documentFooter          String?

  // Uploads
  maxUploadMb    Int @default(100)
  storageQuotaMb Int @default(10240)

  /// True only for the demo database. Shows a permanent DEMO banner.
  isDemo    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model PricingPolicy {
  id                   String        @id @default(cuid())
  name                 String        @unique
  description          String?
  method               PricingMethod @default(MARKUP)
  markupPercent        Decimal       @default(1.0) @db.Decimal(8, 4)
  marginPercent        Decimal       @default(0.5) @db.Decimal(6, 4)
  minimumOrderCharge   Decimal       @default(0) @db.Decimal(10, 2)
  minimumMarginPercent Decimal       @default(0.25) @db.Decimal(6, 4)
  priceRoundingStep    Decimal       @default(1) @db.Decimal(10, 2)
  roundingMode         RoundingMode  @default(UP)
  isDefault            Boolean       @default(false)
  isArchived           Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  customers Customer[]
  quotes    Quote[]
  orders    Order[]
}

model NumberSequence {
  key         String  @id
  prefix      String
  nextValue   Int     @default(1)
  padding     Int     @default(4)
  includeYear Boolean @default(true)
}

// ───────────────────────────── Customers ─────────────────────────────

enum ContactMethod {
  PHONE
  WHATSAPP
  EMAIL
  SMS
  OTHER
}

model Customer {
  id               String         @id @default(cuid())
  number           String         @unique
  name             String
  company          String?
  email            String?
  emailNormalized  String?
  phone            String?
  phoneNormalized  String?
  preferredContact ContactMethod  @default(PHONE)
  addressLine1     String?
  addressLine2     String?
  city             String?
  postalCode       String?
  country          String?        @default("Israel")
  taxId            String?
  vatExempt        Boolean        @default(false)
  notes            String?
  tags             String[]       @default([])
  pricingPolicyId  String?
  pricingPolicy    PricingPolicy? @relation(fields: [pricingPolicyId], references: [id], onDelete: SetNull)
  marketingConsent Boolean        @default(false)
  archivedAt       DateTime?
  anonymizedAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  quotes   Quote[]
  orders   Order[]
  payments Payment[]
  designs  DesignProject[]
  files    FileAttachment[]

  @@index([name])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([archivedAt])
}

// ───────────────────────────── Materials & inventory ─────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  name        String   @unique
  website     String?
  contactName String?
  email       String?
  phone       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials Material[]
  spools    Spool[]
  expenses  Expense[]
}

model MaterialType {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  defaultDensity Decimal? @db.Decimal(6, 3)
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  materials Material[]
  printers  Printer[]
}

model Material {
  id                String       @id @default(cuid())
  materialTypeId    String
  materialType      MaterialType @relation(fields: [materialTypeId], references: [id])
  brand             String
  productLine       String?
  colorName         String
  colorHex          String?
  diameterMm        Decimal      @default(1.75) @db.Decimal(4, 2)
  densityGcm3       Decimal?     @db.Decimal(6, 3)
  /// Price per kg used for pricing. NULL = unknown; pricing refuses to guess.
  pricePerKg        Decimal?     @db.Decimal(10, 2)
  /// Optional override of the global material waste allowance.
  wastePercent      Decimal?     @db.Decimal(6, 4)
  defaultSpoolNetG  Int          @default(1000)
  emptySpoolWeightG Int?
  minStockG         Int          @default(0)
  sku               String?
  supplierId        String?
  supplier          Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  storageLocation   String?
  notes             String?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  spools            Spool[]
  movements         StockMovement[]
  reservations      MaterialReservation[]
  quoteItems        QuoteItem[]           @relation("QuoteItemMaterial")
  quoteSupportItems QuoteItem[]           @relation("QuoteItemSupportMaterial")
  orderItems        OrderItem[]           @relation("OrderItemMaterial")
  orderSupportItems OrderItem[]           @relation("OrderItemSupportMaterial")
  jobs              PrintJob[]
  designDefaults    DesignProject[]

  @@index([materialTypeId])
  @@index([isActive])
}

enum SpoolStatus {
  SEALED
  OPEN
  EMPTY
  DISCARDED
}

model Spool {
  id                  String      @id @default(cuid())
  code                String      @unique
  materialId          String
  material            Material    @relation(fields: [materialId], references: [id])
  supplierId          String?
  supplier            Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  expenseId           String?
  expense             Expense?    @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  purchasedAt         DateTime?
  /// Purchase price plus allocated shipping/non-reclaimable tax, for this spool.
  landedCost          Decimal?    @db.Decimal(10, 2)
  netWeightG          Decimal     @db.Decimal(10, 2)
  remainingG          Decimal     @db.Decimal(10, 2)
  /// False while remainingG is only an estimate from recorded consumption.
  remainingIsMeasured Boolean     @default(false)
  lastWeighedAt       DateTime?
  status              SpoolStatus @default(SEALED)
  storageLocation     String?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  movements StockMovement[]

  @@index([materialId, status])
}

enum StockMovementType {
  RECEIVED
  CONSUMED
  WASTE
  FAILED_PRINT
  ADJUSTMENT
  RECONCILIATION
  RETURNED
}

model StockMovement {
  id          String            @id @default(cuid())
  materialId  String
  material    Material          @relation(fields: [materialId], references: [id])
  spoolId     String?
  spool       Spool?            @relation(fields: [spoolId], references: [id], onDelete: SetNull)
  type        StockMovementType
  /// Signed: positive adds stock, negative removes stock.
  quantityG   Decimal           @db.Decimal(10, 2)
  /// Cost per kg at the time of the movement (spool landed cost or material price).
  costPerKg   Decimal?          @db.Decimal(10, 4)
  printJobId  String?
  printJob    PrintJob?         @relation(fields: [printJobId], references: [id], onDelete: SetNull)
  orderItemId String?
  orderItem   OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  reason      String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([materialId, createdAt])
  @@index([spoolId])
  @@index([printJobId])
  @@index([orderItemId])
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

model MaterialReservation {
  id          String            @id @default(cuid())
  materialId  String
  material    Material          @relation(fields: [materialId], references: [id])
  orderItemId String
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantityG   Decimal           @db.Decimal(10, 2)
  consumedG   Decimal           @default(0) @db.Decimal(10, 2)
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([orderItemId, materialId])
  @@index([materialId, status])
}

// ───────────────────────────── Printers ─────────────────────────────

enum PrinterStatus {
  AVAILABLE
  PRINTING
  MAINTENANCE
  OFFLINE
  RETIRED
}

model Printer {
  id                    String        @id @default(cuid())
  name                  String        @unique
  manufacturer          String?
  model                 String
  serialNumber          String?
  nozzleDiameterMm      Decimal       @default(0.4) @db.Decimal(4, 2)
  nozzleNotes           String?
  hasMultiMaterial      Boolean       @default(false)
  buildVolume           String?
  status                PrinterStatus @default(AVAILABLE)
  purchasePrice         Decimal?      @db.Decimal(10, 2)
  purchasedAt           DateTime?
  expectedLifetimeHours Int?
  powerWatts            Int?
  maintenancePerHour    Decimal?      @db.Decimal(10, 4)
  consumablesPerHour    Decimal?      @db.Decimal(10, 4)
  /// If set, replaces the computed machine cost per hour entirely.
  hourlyRateOverride    Decimal?      @db.Decimal(10, 4)
  initialPrintHours     Decimal       @default(0) @db.Decimal(10, 2)
  location              String?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  supportedMaterialTypes MaterialType[]
  maintenanceTasks       MaintenanceTask[]
  maintenanceLogs        MaintenanceLog[]
  jobs                   PrintJob[]
  quoteItems             QuoteItem[]
  orderItems             OrderItem[]
  expenses               Expense[]
  designDefaults         DesignProject[]

  @@index([status])
}

model MaintenanceTask {
  id                 String    @id @default(cuid())
  printerId          String
  printer            Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  title              String
  intervalPrintHours Int?
  intervalDays       Int?
  lastDoneAt         DateTime?
  lastDonePrintHours Decimal?  @db.Decimal(10, 2)
  notes              String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())

  logs MaintenanceLog[]

  @@index([printerId])
}

model MaintenanceLog {
  id           String           @id @default(cuid())
  printerId    String
  printer      Printer          @relation(fields: [printerId], references: [id], onDelete: Cascade)
  taskId       String?
  task         MaintenanceTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  performedAt  DateTime
  description  String
  cost         Decimal?         @db.Decimal(10, 2)
  printHoursAt Decimal?         @db.Decimal(10, 2)
  createdAt    DateTime         @default(now())

  @@index([printerId, performedAt])
}

// ───────────────────────────── Quotes & orders ─────────────────────────────

enum ServiceType {
  PRINT_ONLY
  MODELING_AND_PRINTING
  MODELING_ONLY
  SCANNING_ONLY
  SCANNING_AND_PRINTING
}

enum ModelingMode {
  HOURLY
  FIXED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  REVISED
}

model Quote {
  id                 String         @id @default(cuid())
  number             String
  revision           Int            @default(1)
  customerId         String
  customer           Customer       @relation(fields: [customerId], references: [id])
  status             QuoteStatus    @default(DRAFT)
  title              String?
  issueDate          DateTime       @default(now())
  validUntil         DateTime?
  requestedBy        DateTime?
  pricingPolicyId    String?
  pricingPolicy      PricingPolicy? @relation(fields: [pricingPolicyId], references: [id], onDelete: SetNull)
  currency           String         @default("ILS")
  /// Snapshot of rates, policy and tax used to price this document.
  pricingContext     Json
  orderDiscountType  DiscountType?
  orderDiscountValue Decimal?       @db.Decimal(12, 4)
  shippingMethod     String?
  shippingCharge     Decimal        @default(0) @db.Decimal(12, 2)
  shippingCost       Decimal        @default(0) @db.Decimal(12, 2)
  depositPercent     Decimal?       @db.Decimal(6, 4)
  paymentTerms       String?
  customerNotes      String?
  internalNotes      String?

  // Denormalized pricing results (source of truth: pricingSummary)
  pricingSummary    Json?
  pricingComplete   Boolean @default(false)
  itemsNet          Decimal @default(0) @db.Decimal(12, 2)
  orderDiscount     Decimal @default(0) @db.Decimal(12, 2)
  minimumAdjustment Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount     Decimal @default(0) @db.Decimal(12, 2)
  vatAmount         Decimal @default(0) @db.Decimal(12, 2)
  total             Decimal @default(0) @db.Decimal(12, 2)
  depositAmount     Decimal @default(0) @db.Decimal(12, 2)
  estimatedCost     Decimal @default(0) @db.Decimal(12, 2)
  estimatedProfit   Decimal @default(0) @db.Decimal(12, 2)

  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  approvalNote    String?
  previousId      String?   @unique
  previous        Quote?    @relation("QuoteRevisions", fields: [previousId], references: [id], onDelete: SetNull)
  next            Quote?    @relation("QuoteRevisions")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items QuoteItem[]
  order Order?
  files FileAttachment[]

  @@unique([number, revision])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id          String      @id @default(cuid())
  quoteId     String
  quote       Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int
  serviceType ServiceType
  partName    String
  description String?
  category    String?
  quantity    Int

  materialId          String?
  material            Material?      @relation("QuoteItemMaterial", fields: [materialId], references: [id], onDelete: SetNull)
  supportMaterialId   String?
  supportMaterial     Material?      @relation("QuoteItemSupportMaterial", fields: [supportMaterialId], references: [id], onDelete: SetNull)
  printerId           String?
  printer             Printer?       @relation(fields: [printerId], references: [id], onDelete: SetNull)
  designProjectId     String?
  designProject       DesignProject? @relation(fields: [designProjectId], references: [id], onDelete: SetNull)
  colorNote           String?
  deadline            DateTime?
  specialInstructions String?

  /// Complete, resolved pricing input (includes rates/material prices at pricing time).
  pricingInput  Json
  /// Full pricing breakdown produced by the engine.
  pricingResult Json?
  unitPrice     Decimal? @db.Decimal(12, 2)
  lineNet       Decimal? @db.Decimal(12, 2)
  lineCost      Decimal? @db.Decimal(12, 2)

  files FileAttachment[]

  @@index([quoteId])
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  AWAITING_MODELING
  AWAITING_APPROVAL
  QUEUED
  PRINTING
  POST_PROCESSING
  QUALITY_CHECK
  READY
  DELIVERED
  COMPLETED
  CANCELED
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  RUSH
}

enum DeliveryMethod {
  PICKUP
  COURIER
  POST
  OTHER
}

model Order {
  id                 String         @id @default(cuid())
  number             String         @unique
  customerId         String
  customer           Customer       @relation(fields: [customerId], references: [id])
  quoteId            String?        @unique
  quote              Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  status             OrderStatus    @default(DRAFT)
  title              String?
  priority           OrderPriority  @default(NORMAL)
  orderDate          DateTime       @default(now())
  dueDate            DateTime?
  pricingPolicyId    String?
  pricingPolicy      PricingPolicy? @relation(fields: [pricingPolicyId], references: [id], onDelete: SetNull)
  currency           String         @default("ILS")
  pricingContext     Json
  orderDiscountType  DiscountType?
  orderDiscountValue Decimal?       @db.Decimal(12, 4)
  shippingMethod     String?
  shippingCharge     Decimal        @default(0) @db.Decimal(12, 2)
  shippingCost       Decimal        @default(0) @db.Decimal(12, 2)
  deliveryMethod     DeliveryMethod @default(PICKUP)
  deliveryAddress    String?
  depositPercent     Decimal?       @db.Decimal(6, 4)
  paymentTerms       String?
  customerNotes      String?
  internalNotes      String?

  pricingSummary    Json?
  pricingComplete   Boolean  @default(false)
  itemsNet          Decimal  @default(0) @db.Decimal(12, 2)
  orderDiscount     Decimal  @default(0) @db.Decimal(12, 2)
  minimumAdjustment Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount     Decimal  @default(0) @db.Decimal(12, 2)
  vatAmount         Decimal  @default(0) @db.Decimal(12, 2)
  total             Decimal  @default(0) @db.Decimal(12, 2)
  depositAmount     Decimal  @default(0) @db.Decimal(12, 2)
  estimatedCost     Decimal  @default(0) @db.Decimal(12, 2)
  estimatedProfit   Decimal  @default(0) @db.Decimal(12, 2)
  /// Net cash received (payments − refunds, excluding voided). Maintained transactionally.
  amountPaid        Decimal  @default(0) @db.Decimal(12, 2)
  actualCost        Decimal? @db.Decimal(12, 2)

  revision           Int       @default(1)
  confirmedAt        DateTime?
  readyAt            DateTime?
  deliveredAt        DateTime?
  completedAt        DateTime?
  canceledAt         DateTime?
  cancelReason       String?
  deliveryNoteNumber String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items    OrderItem[]
  payments Payment[]
  jobs     PrintJob[]
  expenses Expense[]
  files    FileAttachment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([orderDate])
}

model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position    Int
  serviceType ServiceType
  partName    String
  description String?
  category    String?
  quantity    Int

  materialId          String?
  material            Material?      @relation("OrderItemMaterial", fields: [materialId], references: [id], onDelete: SetNull)
  supportMaterialId   String?
  supportMaterial     Material?      @relation("OrderItemSupportMaterial", fields: [supportMaterialId], references: [id], onDelete: SetNull)
  printerId           String?
  printer             Printer?       @relation(fields: [printerId], references: [id], onDelete: SetNull)
  designProjectId     String?
  designProject       DesignProject? @relation(fields: [designProjectId], references: [id], onDelete: SetNull)
  colorNote           String?
  deadline            DateTime?
  specialInstructions String?

  pricingInput  Json
  pricingResult Json?
  unitPrice     Decimal? @db.Decimal(12, 2)
  lineNet       Decimal? @db.Decimal(12, 2)
  lineCost      Decimal? @db.Decimal(12, 2)
  actualCost    Decimal? @db.Decimal(12, 2)

  /// Units that passed QC across all print jobs (maintained by production service).
  quantityCompleted Int @default(0)

  reservations MaterialReservation[]
  jobItems     PrintJobItem[]
  movements    StockMovement[]
  files        FileAttachment[]

  @@index([orderId])
  @@index([materialId])
  @@index([designProjectId])
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  BIT
  PAYBOX
  PAYPAL
  CHECK
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  number      String        @unique
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  kind        PaymentKind   @default(PAYMENT)
  method      PaymentMethod
  /// Always positive; kind determines direction.
  amount      Decimal       @db.Decimal(12, 2)
  isDeposit   Boolean       @default(false)
  receivedAt  DateTime
  reference   String?
  /// Processor fee paid by the business (internal cost).
  feeAmount   Decimal       @default(0) @db.Decimal(12, 2)
  notes       String?
  voidedAt    DateTime?
  voidReason  String?
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([orderId])
  @@index([customerId])
  @@index([receivedAt])
}

// ───────────────────────────── Production ─────────────────────────────

enum JobStatus {
  QUEUED
  PRINTING
  POST_PROCESSING
  QUALITY_CHECK
  DONE
  FAILED
  CANCELED
}

model PrintJob {
  id               String     @id @default(cuid())
  number           String     @unique
  orderId          String
  order            Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  printerId        String?
  printer          Printer?   @relation(fields: [printerId], references: [id], onDelete: SetNull)
  materialId       String?
  material         Material?  @relation(fields: [materialId], references: [id], onDelete: SetNull)
  status           JobStatus  @default(QUEUED)
  queuePosition    Int        @default(0)
  plannedStart     DateTime?
  startedAt        DateTime?
  printedAt        DateTime?
  completedAt      DateTime?
  estimatedMinutes Decimal?   @db.Decimal(10, 2)
  actualMinutes    Decimal?   @db.Decimal(10, 2)
  estimatedGrams   Decimal?   @db.Decimal(10, 2)
  actualGrams      Decimal?   @db.Decimal(10, 2)
  failureReason    String?
  reprintOfId      String?
  reprintOf        PrintJob?  @relation("Reprints", fields: [reprintOfId], references: [id], onDelete: SetNull)
  reprints         PrintJob[] @relation("Reprints")
  qcNotes          String?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  items     PrintJobItem[]
  movements StockMovement[]
  files     FileAttachment[]

  @@index([orderId])
  @@index([printerId, status])
  @@index([status])
}

model PrintJobItem {
  id           String    @id @default(cuid())
  jobId        String
  job          PrintJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity     Int
  quantityGood Int?

  @@unique([jobId, orderItemId])
  @@index([orderItemId])
}

// ───────────────────────────── Modeling & scanning ─────────────────────────────

enum DesignType {
  MODELING
  SCANNING
  SCAN_TO_CAD
}

enum DesignStatus {
  REQUESTED
  IN_PROGRESS
  AWAITING_APPROVAL
  REVISION_REQUESTED
  APPROVED
  DELIVERED
  CANCELED
}

enum Complexity {
  SIMPLE
  MODERATE
  COMPLEX
  EXPERT
}

enum TimeCategory {
  MODELING
  SCANNING
  SCAN_CLEANUP
  REVERSE_ENGINEERING
  REVISION
  OTHER
}

enum DesignOwnership {
  CUSTOMER
  BUSINESS
  SHARED
}

model DesignProject {
  id                    String          @id @default(cuid())
  number                String          @unique
  customerId            String
  customer              Customer        @relation(fields: [customerId], references: [id])
  title                 String
  description           String?
  type                  DesignType      @default(MODELING)
  status                DesignStatus    @default(REQUESTED)
  complexity            Complexity      @default(MODERATE)
  estimatedHours        Decimal?        @db.Decimal(8, 2)
  includedRevisions     Int             @default(2)
  feeMode               ModelingMode    @default(HOURLY)
  fixedFee              Decimal?        @db.Decimal(12, 2)
  hourlyRate            Decimal?        @db.Decimal(10, 2)
  additionalRevisionFee Decimal?        @db.Decimal(12, 2)
  ownership             DesignOwnership @default(CUSTOMER)
  licenseNotes          String?
  dueDate               DateTime?
  approvedAt            DateTime?
  approvalNote          String?
  deliveredAt           DateTime?

  // Reusable print defaults for re-orders
  defaultMaterialId   String?
  defaultMaterial     Material? @relation(fields: [defaultMaterialId], references: [id], onDelete: SetNull)
  defaultPrinterId    String?
  defaultPrinter      Printer?  @relation(fields: [defaultPrinterId], references: [id], onDelete: SetNull)
  defaultGramsPerUnit Decimal?  @db.Decimal(10, 2)
  defaultSupportGrams Decimal?  @db.Decimal(10, 2)
  defaultPrintMinutes Decimal?  @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries DesignTimeEntry[]
  revisions   DesignRevision[]
  orderItems  OrderItem[]
  quoteItems  QuoteItem[]
  files       FileAttachment[]

  @@index([customerId])
  @@index([status])
}

model DesignTimeEntry {
  id        String        @id @default(cuid())
  projectId String
  project   DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  TimeCategory
  hours     Decimal       @db.Decimal(6, 2)
  date      DateTime
  billable  Boolean       @default(true)
  notes     String?
  createdAt DateTime      @default(now())

  @@index([projectId])
}

model DesignRevision {
  id           String        @id @default(cuid())
  projectId    String
  project      DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number       Int
  description  String
  requestedAt  DateTime      @default(now())
  isChargeable Boolean       @default(false)
  charge       Decimal?      @db.Decimal(12, 2)
  billedAt     DateTime?
  completedAt  DateTime?

  @@unique([projectId, number])
}

// ───────────────────────────── Finance ─────────────────────────────

enum ExpenseCategory {
  MATERIALS
  EQUIPMENT
  MAINTENANCE
  CONSUMABLES
  SOFTWARE
  SHIPPING
  UTILITIES
  RENT
  MARKETING
  FEES
  PROFESSIONAL_SERVICES
  OTHER
}

model Expense {
  id            String          @id @default(cuid())
  date          DateTime
  category      ExpenseCategory
  description   String
  supplierId    String?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// Total paid, including VAT.
  amount        Decimal         @db.Decimal(12, 2)
  /// VAT portion of amount (informational; reclaimable only for VAT-registered businesses).
  vatAmount     Decimal         @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  reference     String?
  printerId     String?
  printer       Printer?        @relation(fields: [printerId], references: [id], onDelete: SetNull)
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  spools Spool[]
  files  FileAttachment[]

  @@index([date])
  @@index([category])
}

// ───────────────────────────── Files ─────────────────────────────

enum FileKind {
  MODEL
  IMAGE
  DOCUMENT
  ARCHIVE
  OTHER
}

model FileAttachment {
  id              String         @id @default(cuid())
  originalName    String
  storageKey      String         @unique
  mimeType        String
  extension       String
  sizeBytes       Int
  sha256          String
  kind            FileKind
  purpose         String?
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quoteId         String?
  quote           Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  quoteItemId     String?
  quoteItem       QuoteItem?     @relation(fields: [quoteItemId], references: [id], onDelete: SetNull)
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId     String?
  orderItem       OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  designProjectId String?
  designProject   DesignProject? @relation(fields: [designProjectId], references: [id], onDelete: SetNull)
  printJobId      String?
  printJob        PrintJob?      @relation(fields: [printJobId], references: [id], onDelete: SetNull)
  expenseId       String?
  expense         Expense?       @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  uploadedById    String?
  createdAt       DateTime       @default(now())

  @@index([customerId])
  @@index([orderId])
  @@index([quoteId])
  @@index([designProjectId])
}
